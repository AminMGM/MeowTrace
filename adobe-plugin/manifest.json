{
  "manifestVersion": 5,
  "id": "com.aminmgm.meowtrace.bridge",
  "name": "MeowTrace Bridge",
  "version": "0.1.0",
  "main": "index.html",
  "host": [{ "app": "PS", "minVersion": "24.0.0" }],
  "entrypoints": [
    {
      "type": "panel",
      "id": "meowtracePanel",
      "label": { "default": "MeowTrace" },
      "minimumSize": { "width": 220, "height": 160 },
      "preferredDockedSize": { "width": 260, "height": 220 }
    }
  ],
  "requiredPermissions": {
    "network": { "domains": ["http://127.0.0.1"] },
    "localFileSystem": "request"
  }
}
